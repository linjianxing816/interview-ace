# InterviewAce 环境变量
# 用法：复制本文件为 .env，填入真实值
# cp .env.example .env  （或在 Windows 上 copy .env.example .env）

# ========== 数据库 ==========
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=mock_interview
DB_SSLMODE=disable

# ========== LLM ==========
# OpenAI-compatible API
# 填你新申请的 key，我不看也不打印
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
# 推理模式。默认关：开着更贵（CoT 按输出计费）、更慢、同一输入两次结果差异更大。
# 只有确认某个场景需要多步推理时才打开。
LLM_THINKING=false
# 单次调用超时（秒）
LLM_TIMEOUT_SEC=60
# 单次回复的最大 token
LLM_MAX_TOKENS=1024

# ========== 服务 ==========
SERVER_PORT=8090
# JWT 签名密钥——开发期随便填，生产要换
JWT_SECRET=dev-secret-change-me-in-production

# ========== 文件 ==========
# 简历上传目录（相对于项目根目录）
UPLOAD_DIR=./uploads
# 单文件最大 5MB
MAX_UPLOAD_MB=5
